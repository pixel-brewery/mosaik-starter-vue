{
  "name": "mosaik-starter-vue",
  "version": "0.0.0",
  "private": true,
  "description": "An independent Mosaik starter for Vue.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
